# Настройки shellcheck для LinuxConfigurator.
#
# Аналог ScriptAnalyzerSettings.psd1 в WindowsConfigurator: правила отключаются
# не потому, что линтер мешает, а потому, что архитектура проекта делает их
# неприменимыми. Каждое отключение обосновано.

# SC2034 (переменная не используется)
#   Состояние прогона объявляется в одном файле lib/common, а читается из шагов,
#   оркестратора и меню. shellcheck анализирует каждый файл изолированно и
#   междумодульного использования не видит. Отключать точечно в 40 местах -
#   это шум, который утонет и перестанет замечаться.
#
# SC2088 (тильда в кавычках не раскрывается)
#   Намеренно: path_expand_tokens разбирает префикс "~/" как литерал, чтобы путь
#   из конфигурации не проходил через раскрытие оболочкой. Раскрытие сделанное
#   самим bash было бы неуправляемым и зависело от HOME вызывающего.
#
# SC1090 / SC1091 (source с невычисляемым путём, файл не найден)
#   Файлы lib/ подключаются через glob в load-functions.sh: новый шаг подхватывается
#   автоматически и не регистрируется вручную. Статически путь не вычисляется.
disable=SC2034,SC2088,SC1090,SC1091

# Проект рассчитан на bash 5.x (declare -A, EPOCHREALTIME, ${var,,}).
shell=bash
